{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devsecninja.github.io/net-worth-calculator/contracts/backup-envelope-v2.schema.json",
  "title": "Net Worth Calculator encrypted backup envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "formatVersion", "exportedAt", "payload"],
  "properties": {
    "format": { "const": "net-worth-backup" },
    "formatVersion": { "const": 2 },
    "exportedAt": { "type": "string", "format": "date-time" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "formatVersion", "vaultSchemaVersion", "kdf", "cipher", "ciphertext"],
      "properties": {
        "format": { "const": "net-worth-vault" },
        "formatVersion": { "const": 1 },
        "vaultSchemaVersion": { "const": 2 },
        "kdf": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "hash", "iterations", "salt"],
          "properties": {
            "name": { "const": "PBKDF2" },
            "hash": { "const": "SHA-256" },
            "iterations": { "type": "integer", "minimum": 600000, "maximum": 2000000 },
            "salt": {
              "type": "string",
              "minLength": 22,
              "maxLength": 22,
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          }
        },
        "cipher": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "iv", "tagLength"],
          "properties": {
            "name": { "const": "AES-GCM" },
            "iv": {
              "type": "string",
              "minLength": 16,
              "maxLength": 16,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "tagLength": { "const": 128 }
          }
        },
        "ciphertext": {
          "type": "string",
          "minLength": 22,
          "maxLength": 13981014,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      }
    }
  }
}
