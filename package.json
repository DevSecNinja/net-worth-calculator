{
  "name": "net-worth-calculator",
  "version": "0.5.2",
  "description": "A private, local-first encrypted net worth calculator PWA",
  "license": "MIT",
  "private": false,
  "type": "module",
  "engines": {
    "node": "v26.13.1",
    "npm": "12.2.2"
  },
  "scripts": {
    "build": "vite build",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run test:build",
    "dev": "vite --host 127.0.0.1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:icons": "node scripts/generate-icons.mjs",
    "lint": "eslint . --max-warnings 0",
    "preview": "node scripts/serve-dist.mjs --dir dist --port 4173",
    "test": "vitest run",
    "test:build": "node scripts/verify-build.mjs",
    "test:build:bases": "node scripts/verify-build-bases.mjs",
    "test:coverage": "vitest run --coverage",
    "test:deployment": "playwright test --config playwright.deployment.config.ts",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:headed": "npm run build && playwright test --headed",
    "test:performance": "npm run build && playwright test --config playwright.performance.config.ts",
    "test:privacy": "npm run build && playwright test tests/privacy",
    "test:pwa": "npm run build && playwright test tests/pwa",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "decimal.js": "10.6.0",
    "idb": "8.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "recharts": "3.10.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fake-indexeddb": "6.2.8",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.1.0"
  }
}
